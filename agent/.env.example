# 模型提供商:openai-compatible, anthropic, gemini
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=

# Optional workspace configuration
AGENT_WORKSPACE="D:\agent_workspace"
# Optional fallback path used when the primary audit log cannot be written.
# AGENT_AUDIT_FALLBACK_PATH="D:\agent_workspace\.agent_audit_fallback.jsonl"

# Optional execution limits
AGENT_MAX_ITERATIONS=10
AGENT_REQUEST_TIMEOUT=30
# Maximum number of model/tool workflows running in this process.
AGENT_MAX_CONCURRENT=4
# Maximum time a request waits for an available concurrency slot.
AGENT_QUEUE_TIMEOUT=10

# The model service receives the sanitized user request and selected tool context.
# Do not put secrets or private credentials in prompts.
